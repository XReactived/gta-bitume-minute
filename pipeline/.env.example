# Copie ce fichier en ".env" puis remplis chaque ligne.

# Twitch : https://dev.twitch.tv/console/apps -> "Register Your Application"
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Claude (légendes, hashtags, hook) : https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# TikTok : https://developers.tiktok.com -> Manage apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
